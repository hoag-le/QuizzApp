<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Cấu hình kết nối MySQL (Khi chạy mạng LAN: đổi ServerHost thành IP hoặc Hostname máy chủ; Khi chạy máy mới: đổi DbPass theo mật khẩu MySQL của máy đó) -->
        <add key="ServerHost" value="127.0.0.1" />
        <add key="Port" value="3306" />
        <add key="DbName" value="QuizzAppDB" />
        <add key="DbUser" value="root" />
        <add key="DbPass" value="" />
    </appSettings>
</configuration>
