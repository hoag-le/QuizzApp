<Window x:Class="QuizzApp.GUI.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Làm bài kiểm tra - QUIZ MASTER"
        Height="680"
        Width="1060"
        MinHeight="520"
        MinWidth="780"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        StateChanged="Window_StateChanged"
        Closed="Window_Closed"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3563E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#172554"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtExamTitle"
                                   Text="Đề thi C# cơ bản"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="badgeExamMode"
                                Background="#3563E9"
                                CornerRadius="6"
                                Padding="9,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="txtExamModeBadge"
                                       Text="Thi thật"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="txtProgressSubtitle"
                               Text="Đã trả lời: 0/10 câu • Tự động lưu tiến độ"
                               Foreground="#94A3B8"
                               FontSize="12"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Timer Box -->
                <Border Grid.Column="1"
                        x:Name="borderTimer"
                        Background="#1E3A8A"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,8"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱ "
                                   Foreground="#93C5FD"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTimer"
                                   Text="15:00"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Action Button (Submit or Exit) -->
                <Button Grid.Column="2"
                        x:Name="btnSubmitOrClose"
                        Content="Nộp bài"
                        Style="{StaticResource PrimaryButton}"
                        Background="#10B981"
                        VerticalAlignment="Center"
                        Click="BtnSubmitOrClose_Click"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Question & Options -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="26"
                    Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Question header & text -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <WrapPanel Margin="0,0,0,10">
                            <Border Background="#EFF6FF"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="txtQuestionNumber"
                                           Text="Câu 1 / 10"
                                           Foreground="#2563EB"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>

                            <Border x:Name="badgeDifficulty"
                                    Background="#DCFCE7"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="txtDifficultyBadge"
                                           Text="Dễ"
                                           Foreground="#15803D"
                                           FontSize="11.5"
                                           FontWeight="Bold"/>
                            </Border>

                            <Border x:Name="badgeQuestionType"
                                    Background="#F1F5F9"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="txtQuestionTypeBadge"
                                           Text="Chọn 1 đáp án"
                                           Foreground="#475569"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <Border x:Name="badgeReviewStatus"
                                    Visibility="Collapsed"
                                    CornerRadius="6"
                                    Padding="10,4">
                                <TextBlock x:Name="txtReviewStatus"
                                           Text="Chính xác"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>
                        </WrapPanel>

                        <TextBlock x:Name="txtQuestionContent"
                                   Text="Nội dung câu hỏi sẽ hiển thị tại đây?"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                    </StackPanel>

                    <!-- 4 Options -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Option A -->
                            <Border x:Name="borderOptA"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="14,12"
                                    Margin="0,0,0,10"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OptionA_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="circleOptA"
                                            Width="26" Height="26"
                                            CornerRadius="13"
                                            Background="#E2E8F0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="lblOptA" Text="A" FontWeight="Bold" FontSize="12"
                                                   Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               x:Name="txtOptA"
                                               Text="Đáp án A"
                                               FontSize="14"
                                               Foreground="#1E293B"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Option B -->
                            <Border x:Name="borderOptB"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="14,12"
                                    Margin="0,0,0,10"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OptionB_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="circleOptB"
                                            Width="26" Height="26"
                                            CornerRadius="13"
                                            Background="#E2E8F0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="lblOptB" Text="B" FontWeight="Bold" FontSize="12"
                                                   Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               x:Name="txtOptB"
                                               Text="Đáp án B"
                                               FontSize="14"
                                               Foreground="#1E293B"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Option C -->
                            <Border x:Name="borderOptC"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="14,12"
                                    Margin="0,0,0,10"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OptionC_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="circleOptC"
                                            Width="26" Height="26"
                                            CornerRadius="13"
                                            Background="#E2E8F0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="lblOptC" Text="C" FontWeight="Bold" FontSize="12"
                                                   Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               x:Name="txtOptC"
                                               Text="Đáp án C"
                                               FontSize="14"
                                               Foreground="#1E293B"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Option D -->
                            <Border x:Name="borderOptD"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="14,12"
                                    Margin="0,0,0,6"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OptionD_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="circleOptD"
                                            Width="26" Height="26"
                                            CornerRadius="13"
                                            Background="#E2E8F0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="lblOptD" Text="D" FontWeight="Bold" FontSize="12"
                                                   Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               x:Name="txtOptD"
                                               Text="Đáp án D"
                                               FontSize="14"
                                               Foreground="#1E293B"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Explanation Box (Visible in Review Mode or Practice Mode) -->
                    <Border Grid.Row="2"
                            x:Name="borderExplanation"
                            Visibility="Collapsed"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,10,0,6">
                        <StackPanel>
                            <TextBlock Text="💡 Giải thích đáp án:"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#1E40AF"/>
                            <TextBlock x:Name="txtExplanation"
                                       Text=""
                                       FontSize="12.5"
                                       Foreground="#1E3A8A"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Navigation & Flag Buttons: [← Trước] [⚑ Đánh dấu] [Sau →] -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="btnPrev"
                                Content="← Câu trước"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnPrev_Click"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="btnFlagQuestion"
                                    Content="⚑ Đánh dấu xem lại"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="4,0"
                                    Click="BtnFlagQuestion_Click"/>

                            <Button x:Name="btnPracticeCheck"
                                    Visibility="Collapsed"
                                    Content="👁 Xem đáp án ngay"
                                    Style="{StaticResource SecondaryButton}"
                                    Background="#FEF3C7"
                                    Foreground="#B45309"
                                    BorderBrush="#F59E0B"
                                    Margin="4,0"
                                    Click="BtnPracticeCheck_Click"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                x:Name="btnNext"
                                Content="Câu tiếp theo →"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnNext_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: Question Palette & Result Summary -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Score Summary Card (Shown after submit) -->
                    <Border Grid.Row="0"
                            x:Name="borderResultSummary"
                            Visibility="Collapsed"
                            Background="#F0FDF4"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="KẾT QUẢ BÀI THI"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#15803D"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtFinalScore"
                                       Text="9.0 / 10"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#166534"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,2"/>
                            <TextBlock x:Name="txtFinalDetail"
                                       Text="Đúng: 9 | Sai: 1 | Trống: 0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#15803D"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Filter Wrong Questions Checkbox (Shown after submit) -->
                    <CheckBox Grid.Row="1"
                              x:Name="chkFilterWrongOnly"
                              Visibility="Collapsed"
                              Content="Chỉ hiển thị câu trả lời sai / bỏ trống"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Foreground="#B91C1C"
                              Margin="0,0,0,12"
                              Checked="ChkFilterWrongOnly_Changed"
                              Unchecked="ChkFilterWrongOnly_Changed"/>

                    <TextBlock Grid.Row="2"
                               Text="Bảng điều hướng câu hỏi"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,12"/>

                    <!-- Question Number Buttons WrapPanel -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="wrapQuestionPalette"
                                   HorizontalAlignment="Left"/>
                    </ScrollViewer>

                    <!-- Legend -->
                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <Separator Background="#E2E8F0" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                <Border Width="12" Height="12" Background="#3563E9" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBlock Text="Đã làm" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                <Border Width="12" Height="12" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBlock Text="Chưa làm" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                <Border Width="12" Height="12" Background="#F59E0B" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBlock Text="⚑ Đánh dấu" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                <Border Width="12" Height="12" Background="#10B981" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBlock Text="Đúng" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="12" Height="12" Background="#EF4444" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBlock Text="Sai" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
