<Window x:Class="QuizzApp.GUI.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard Giáo viên / Quản trị Đề thi - QUIZ MASTER"
        Height="700"
        Width="1160"
        MinHeight="560"
        MinWidth="860"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#3563E9"/>
        <SolidColorBrush x:Key="SidebarColor" Color="#172554"/>
        <Style x:Key="RoleBadgeBorderStyle" TargetType="Border"><Setter Property="Background" Value="#DCFCE7"/><Style.Triggers><DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="RoleBadgeTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#15803D"/><Style.Triggers><DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Foreground" Value="#1D4ED8"/></DataTrigger></Style.Triggers></Style>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#DBEAFE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#293B68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3563E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarColor}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="110"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,10,0">
                    <Border Width="42" Height="42" Background="#3563E9" CornerRadius="12">
                        <TextBlock Text="Q" Foreground="White" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TEACHER PORTAL" Foreground="White" FontSize="14.5" FontWeight="Bold"/>
                        <TextBlock Text="Quản trị đề thi &amp; câu hỏi" Foreground="#93C5FD" FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Row="1" Margin="16,8,16,0">
                    <TextBlock Text="QUẢN LÝ NỘI DUNG"
                               Foreground="#94A3B8"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="12,0,0,8"/>

                    <Button x:Name="btnTabExams"
                            Content=" ▣  Quản lý Đề thi"
                            Style="{StaticResource MenuButton}"
                            Background="#3563E9"
                            Foreground="White"
                            Click="BtnTabExams_Click"/>

                    <Button x:Name="btnTabSubjects"
                            Content="📚  Môn học &amp; Chương"
                            Style="{StaticResource MenuButton}"
                            Click="BtnTabSubjects_Click"/>

                    <Button x:Name="btnTabUsers"
                            Content="👤  Quản lý Tài khoản"
                            Style="{StaticResource MenuButton}"
                            Click="BtnTabUsers_Click"/>

                    <Button x:Name="btnTabResults"
                            Content="📊  Thống kê &amp; Báo cáo"
                            Style="{StaticResource MenuButton}"
                            Click="BtnTabResults_Click"/>

                    <Separator Background="#334155" Margin="8,14,8,14" Height="1"/>
                </StackPanel>

                <!-- User & Logout Footer -->
                <Border Grid.Row="2"
                        BorderBrush="#334155"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="txtAdminName"
                                   Text="Giáo viên Quản trị"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,10"/>
                        <Button Content="⎋  Đăng xuất"
                                Background="#EF4444"
                                Foreground="White"
                                BorderThickness="0"
                                Height="32"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="BtnLogout_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="#F3F6FB">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="26,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtHeaderTitle"
                                   Text="Dashboard Tạo &amp; Quản lý Đề thi"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#DBEAFE"
                            CornerRadius="16"
                            Padding="14,6">
                        <TextBlock Text="Giáo viên"
                                   Foreground="#1D4ED8"
                                   FontSize="11.5"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI Stats Row (Only visible in Analytics & Reports view) -->
            <Grid x:Name="gridKpiStats" Grid.Row="1" Visibility="Collapsed" Height="74" Margin="26,12,26,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tổng số môn học" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="txtKpiSubjects" Text="3 môn học" FontSize="17" FontWeight="Bold" Foreground="#1E293B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="4,0,4,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tổng số đề thi" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="txtKpiExams" Text="3 đề thi" FontSize="17" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="4,0,4,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ngân hàng câu hỏi" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="txtKpiQuestions" Text="25 câu hỏi" FontSize="17" FontWeight="Bold" Foreground="#047857" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="8,0,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lượt thi &amp; Điểm TB" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="txtKpiSubmissions" Text="0 lượt • TB: 0.0" FontSize="17" FontWeight="Bold" Foreground="#B45309" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- WORKSPACE AREA -->
            <Grid Grid.Row="2" Margin="26,8,26,20">

                <!-- ==================== TAB 1: MANAGE EXAMS & MATRIX GENERATOR ==================== -->
                <Grid x:Name="viewManageExams" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="colExamList" Width="*"/>
                        <ColumnDefinition x:Name="colExamEditor" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Full-screen List of Exams (shrinks when Exam Editor opens) -->
                    <Border Grid.Column="0"
                            x:Name="borderExamListContainer"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Danh sách đề thi" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                                </StackPanel>
                                <Button Content="+ Tạo đề mới"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="#3563E9"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,8"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="BtnResetExamForm_Click"/>
                            </Grid>

                            <!-- Search & Subject Filter for Exams -->
                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Tìm kiếm tên đề thi hoặc mô tả:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSearchExams"
                                             Style="{StaticResource InputTextBox}"
                                             TextChanged="TxtSearchExams_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Lọc theo môn học:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cboFilterExamSubject"
                                              Height="36"
                                              DisplayMemberPath="Name"
                                              FontSize="12.5"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="CboFilterExamSubject_SelectionChanged"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="🔍 Tìm kiếm"
                                        VerticalAlignment="Bottom"
                                        Height="36"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="16,0"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="BtnSearchExams_Click"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     x:Name="lstExams"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="16,14"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,12,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                                    <TextBlock FontSize="12" Foreground="#475569">
                                                        <Run Text="{Binding SubjectDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="#2563EB"/>
                                                        <Run Text="  •  "/>
                                                        <Run Text="{Binding QuestionCountText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="  •  "/>
                                                        <Run Text="{Binding DurationText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="  •  "/>
                                                        <Run Text="{Binding ModeDisplay, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding ScheduleDisplay, Mode=OneWay}" Foreground="#0F766E" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding ManualOpenButtonText}" BorderThickness="0" Padding="12,8" Margin="0,0,8,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand" Tag="{Binding}" Click="BtnToggleManualOpenExam_Click"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="#FEF3C7"/><Setter Property="Foreground" Value="#B45309"/><Style.Triggers><DataTrigger Binding="{Binding IsManuallyOpened}" Value="True"><Setter Property="Background" Value="#DCFCE7"/><Setter Property="Foreground" Value="#15803D"/></DataTrigger><DataTrigger Binding="{Binding IsPracticeMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                                    <Button Content="✎ Sửa"
                                                            Background="#EFF6FF"
                                                            Foreground="#2563EB"
                                                            BorderThickness="0"
                                                            Padding="14,8"
                                                            Margin="0,0,8,0"
                                                            FontSize="12.5"
                                                            FontWeight="Bold"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            Click="BtnEditExamItem_Click"/>

                                                    <Button Content="Câu hỏi →"
                                                            Background="#3563E9"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Padding="12,8"
                                                            FontSize="12.5"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            Click="BtnManageExamQuestions_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Full-screen Exam Editor & Matrix Generator (Shown when an exam is clicked or '+ Tạo đề mới' is pressed) -->
                    <Border Grid.Column="0"
                            Grid.ColumnSpan="2"
                            x:Name="borderExamEditorPanel"
                            Visibility="Collapsed"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24,20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="txtExamFormTitle"
                                                   Text="Thiết lập đề thi"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#1E293B"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="btnOpenQuestionsFromEditor"
                                                Visibility="Collapsed"
                                                Content="✎  Quản lý câu hỏi →"
                                                Style="{StaticResource PrimaryButton}"
                                                Background="#2563EB"
                                                Padding="16,9"
                                                Margin="0,0,10,0"
                                                Click="BtnOpenQuestionsFromEditor_Click"/>

                                        <Button Content="← Quay lại quản lý đề thi"
                                                Background="#F1F5F9"
                                                Foreground="#334155"
                                                BorderThickness="0"
                                                Padding="14,9"
                                                FontSize="12.5"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Click="BtnCloseExamEditor_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Môn học" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="cboExamSubject"
                                                  Height="34"
                                                  DisplayMemberPath="Name"
                                                  FontSize="12.5"
                                                  VerticalContentAlignment="Center"
                                                  SelectionChanged="CboExamSubject_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Thời gian làm bài" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtExamDuration" Style="{StaticResource InputTextBox}" Text="15"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Tên đề thi" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox x:Name="txtExamTitleInput" Style="{StaticResource InputTextBox}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Mô tả nội dung đề thi" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox x:Name="txtExamDescInput"
                                             Height="50"
                                             Padding="10,6"
                                             FontSize="12.5"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Background="#F8FAFC"
                                             BorderBrush="#CBD5E1"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Chế độ thi" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="cboExamMode" Height="34" SelectedIndex="0" FontSize="12.5" VerticalContentAlignment="Center" SelectionChanged="CboExamMode_SelectionChanged">
                                            <ComboBoxItem Content="Thi thật" Tag="Real"/>
                                            <ComboBoxItem Content="Luyện tập" Tag="Practice"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                        <CheckBox x:Name="chkShuffleQuestions" Content="Trộn thứ tự câu hỏi" IsChecked="True" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="chkShuffleAnswers" Content="Trộn thứ tự đáp án A/B/C/D" IsChecked="False" FontSize="12" Foreground="#334155"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Exam Schedule & Manual Open Box -->
                                <Border x:Name="borderExamScheduleBox" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🕒 Cài đặt lịch thi &amp; Mở đề thi thật:" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Ngày thi" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                                                <DatePicker x:Name="dpExamStartDate" Height="34" FontSize="12.5" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                <TextBlock Text="Giờ thi" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                                                <TextBox x:Name="txtExamStartTime" Style="{StaticResource InputTextBox}" Text="08:00"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                <CheckBox x:Name="chkManualOpenExam" Content="Giáo viên mở đề thủ công ngay" IsChecked="False" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- Matrix Auto Builder Box -->
                                <Border Background="#F8FAFC"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="🎲 Tạo đề ngẫu nhiên theo Ma trận độ khó:"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#1E293B"/>
                                        <TextBlock x:Name="txtMatrixAvailableInfo"
                                                   Text="Khả dụng trong ngân hàng môn này: Dễ: 0 | TB: 0 | Khó: 0"
                                                   FontSize="11"
                                                   Foreground="#2563EB"
                                                   Margin="0,3,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Số câu Dễ" FontSize="11" Foreground="#15803D" FontWeight="SemiBold"/>
                                                <TextBox x:Name="txtMatrixEasy" Style="{StaticResource InputTextBox}" Height="30" Text="3"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                                <TextBlock Text="Số câu TB" FontSize="11" Foreground="#B45309" FontWeight="SemiBold"/>
                                                <TextBox x:Name="txtMatrixMedium" Style="{StaticResource InputTextBox}" Height="30" Text="2"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                                <TextBlock Text="Số câu Khó" FontSize="11" Foreground="#B91C1C" FontWeight="SemiBold"/>
                                                <TextBox x:Name="txtMatrixHard" Style="{StaticResource InputTextBox}" Height="30" Text="1"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="⚡ Sinh đề tự động theo Ma trận"
                                                Style="{StaticResource PrimaryButton}"
                                                Background="#0D9488"
                                                Margin="0,8,0,0"
                                                Click="BtnGenerateMatrixExam_Click"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            x:Name="btnSaveExam"
                                            Content="💾  Lưu đề thi thủ công"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="BtnSaveExam_Click"/>

                                    <Button Grid.Column="1"
                                            x:Name="btnDeleteExam"
                                            Content="🗑 Xóa đề"
                                            Visibility="Collapsed"
                                            Background="#FEE2E2"
                                            Foreground="#B91C1C"
                                            BorderThickness="0"
                                            Padding="14,8"
                                            Margin="10,0,0,0"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="BtnDeleteExam_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ==================== TAB 2: MANAGE QUESTION BANK ==================== -->
                <Grid x:Name="viewManageQuestions" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="colQuestionList" Width="1*"/>
                        <ColumnDefinition x:Name="colQuestionEditor" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Full-screen: Question List + Filter + Import/Export CSV -->
                    <Border x:Name="borderQuestionListContainer" Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Current Exam Title on Left + Add Question & Back buttons on Right -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Đề đang thực hiện: " FontSize="17" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtCurrentExamForQuestions" Text="..." FontSize="17" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="+ Thêm câu hỏi mới"
                                            VerticalAlignment="Center"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="16,8"
                                            Margin="0,0,10,0"
                                            FontSize="12.5"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Click="BtnResetQuestionForm_Click"/>

                                    <Button Content="← Quay lại Quản lý đề thi"
                                            VerticalAlignment="Center"
                                            Background="#F1F5F9"
                                            Foreground="#334155"
                                            BorderThickness="0"
                                            Padding="14,8"
                                            FontSize="12.5"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Click="BtnBackToExamEditor_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Search & Filter by Difficulty -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Tìm kiếm nội dung câu hỏi:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSearchQuestionBank"
                                             Style="{StaticResource InputTextBox}"
                                             TextChanged="TxtSearchQuestionBank_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Lọc theo độ khó:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cboFilterDifficulty"
                                              Height="36"
                                              SelectedIndex="0"
                                              FontSize="12.5"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="CboFilterDifficulty_SelectionChanged">
                                        <ComboBoxItem Content="Tất cả" Tag="All"/>
                                        <ComboBoxItem Content="Dễ" Tag="Easy"/>
                                        <ComboBoxItem Content="Trung bình" Tag="Medium"/>
                                        <ComboBoxItem Content="Khó" Tag="Hard"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="🔍 Tìm kiếm"
                                        VerticalAlignment="Bottom"
                                        Height="36"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="16,0"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="BtnSearchQuestions_Click"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock x:Name="txtQuestionListCount" Text="Danh sách câu hỏi: 0" FontSize="14.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>

                            </Grid>

                            <ListBox Grid.Row="3"
                                     x:Name="lstQuestions"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="LstQuestions_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10"
                                                Margin="0,0,0,8"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding DisplayHeader}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1E293B"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock FontSize="12" Foreground="#475569" Margin="0,5,0,0" TextWrapping="Wrap">
                                                        <Run Text="A. " FontWeight="SemiBold"/><Run Text="{Binding OptionA, Mode=OneWay}"/>
                                                        <Run Text="   |   B. " FontWeight="SemiBold"/><Run Text="{Binding OptionB, Mode=OneWay}"/>
                                                        <Run Text="   |   C. " FontWeight="SemiBold"/><Run Text="{Binding OptionC, Mode=OneWay}"/>
                                                        <Run Text="   |   D. " FontWeight="SemiBold"/><Run Text="{Binding OptionD, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Foreground="#047857" Margin="0,5,0,0">
                                                        <Run Text="Đáp án đúng: "/>
                                                        <Run Text="{Binding CorrectOption, Mode=OneWay}" FontWeight="Bold"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding TypeDisplay, Mode=OneWay}" Foreground="#64748B"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="#EFF6FF"
                                                        CornerRadius="6"
                                                        Padding="10,6"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="✎ Chỉnh sửa →"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#2563EB"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Import / Export CSV Buttons -->
                            <Grid Grid.Row="4" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="📥 Import CSV/Excel"
                                        Background="#EFF6FF"
                                        Foreground="#1D4ED8"
                                        BorderThickness="0"
                                        Padding="10,9"
                                        Margin="0,0,6,0"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="BtnImportCsv_Click"/>
                                <Button Grid.Column="1"
                                        Content="📤 Export CSV/Excel"
                                        Background="#F0FDF4"
                                        Foreground="#15803D"
                                        BorderThickness="0"
                                        Padding="10,9"
                                        Margin="6,0,0,0"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="BtnExportCsv_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Full-screen: Question Editor Form (shown when adding or editing a question) -->
                    <Border x:Name="borderQuestionEditorPanel" Grid.Column="1" Visibility="Collapsed" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="txtQuestionFormTitle"
                                                   Text="Thêm câu hỏi mới"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#1E293B"/>
                                        <TextBlock x:Name="txtQuestionEditorExamSubtitle" Visibility="Collapsed"
                                                   Text="Đề đang thực hiện: ..."
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Content="← Quay lại danh sách câu hỏi"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="#F1F5F9"
                                            Foreground="#475569"
                                            BorderThickness="0"
                                            Padding="14,7"
                                            FontSize="12.5"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Click="BtnCloseQuestionEditor_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Chương học" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cboQChapter" Height="36" DisplayMemberPath="Name" FontSize="13" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Mức độ khó" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cboQDifficulty" Height="36" SelectedIndex="0" FontSize="13" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Dễ" Tag="Easy"/>
                                            <ComboBoxItem Content="Trung bình" Tag="Medium"/>
                                            <ComboBoxItem Content="Khó" Tag="Hard"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Nội dung câu hỏi" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtQContent"
                                         Height="68"
                                         Padding="12,8"
                                         FontSize="13"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Background="#F8FAFC"
                                         BorderBrush="#CBD5E1"
                                         Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Đáp án A" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtQOptA" Style="{StaticResource InputTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Đáp án B" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtQOptB" Style="{StaticResource InputTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Đáp án C" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtQOptC" Style="{StaticResource InputTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Đáp án D" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtQOptD" Style="{StaticResource InputTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Đáp án đúng" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtQCorrectInput" Style="{StaticResource InputTextBox}" Text="A" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Giải thích đáp án" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtQExplanation" Style="{StaticResource InputTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            x:Name="btnSaveQuestion"
                                            Content="💾  Lưu câu hỏi"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="BtnSaveQuestion_Click"/>

                                    <Button Grid.Column="1"
                                            x:Name="btnDeleteQuestion"
                                            Content="🗑 Xóa câu hỏi"
                                            Visibility="Collapsed"
                                            Background="#FEE2E2"
                                            Foreground="#B91C1C"
                                            BorderThickness="0"
                                            Padding="16,10"
                                            Margin="10,0,0,0"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="BtnDeleteQuestion_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ==================== TAB 3: MANAGE SUBJECTS & CHAPTERS ==================== -->
                <Grid x:Name="viewManageSubjects" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="colSubjectList" Width="1*"/>
                        <ColumnDefinition x:Name="colSubjectEditor" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Full-screen: Subject List -->
                    <Border x:Name="borderSubjectListContainer" Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Danh mục Môn học hiện có" FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>

                                </StackPanel>
                                <Button Content="+ Thêm môn học mới"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="16,9"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="BtnResetSubjectForm_Click"/>
                            </Grid>

                            <!-- Search for Subjects -->
                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Tìm kiếm tên môn học hoặc mô tả:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSearchSubjects"
                                             Style="{StaticResource InputTextBox}"
                                             TextChanged="TxtSearchSubjects_TextChanged"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="🔍 Tìm kiếm"
                                        VerticalAlignment="Bottom"
                                        Height="36"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="16,0"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="BtnSearchSubjects_Click"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     x:Name="lstSubjects"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="LstSubjects_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SummaryText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="#EFF6FF"
                                                        CornerRadius="6"
                                                        Padding="12,7"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="⚙ Thiết lập môn &amp; chương →"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#2563EB"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Full-screen: Subject & Chapter Editor Panel -->
                    <Border x:Name="borderSubjectEditorPanel" Grid.Column="1" Visibility="Collapsed" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock x:Name="txtSubjectFormTitle"
                                               Text="Thêm môn học mới"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"
                                               VerticalAlignment="Center"/>
                                    <Button Content="← Quay lại danh sách môn học"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="#F1F5F9"
                                            Foreground="#475569"
                                            BorderThickness="0"
                                            Padding="14,7"
                                            FontSize="12.5"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Click="BtnCloseSubjectEditor_Click"/>
                                </Grid>

                                <TextBlock Text="Tên môn học" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtNewSubjectName" Style="{StaticResource InputTextBox}" Margin="0,0,0,12"/>

                                <TextBlock Text="Mô tả môn học" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtNewSubjectDesc" Style="{StaticResource InputTextBox}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            x:Name="btnSaveSubject"
                                            Content="💾  Lưu môn học mới"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="BtnSaveSubject_Click"/>
                                    <Button Grid.Column="1"
                                            x:Name="btnDeleteSubject"
                                            Content="🗑 Xóa môn học"
                                            Visibility="Collapsed"
                                            Background="#FEE2E2"
                                            Foreground="#B91C1C"
                                            BorderThickness="0"
                                            Padding="16,10"
                                            Margin="10,0,0,0"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="BtnDeleteSubject_Click"/>
                                </Grid>

                                <!-- Chapters Management Section (visible when editing an existing subject) -->
                                <Border x:Name="borderChaptersSection"
                                        Visibility="Collapsed"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="18">
                                    <StackPanel>
                                        <TextBlock x:Name="txtChapterSectionTitle"
                                                   Text="Danh sách Chương học"
                                                   FontSize="15.5"
                                                   FontWeight="Bold"
                                                   Foreground="#1E293B"
                                                   Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     x:Name="txtNewChapterName"
                                                     Style="{StaticResource InputTextBox}"
                                                     Margin="0,0,10,0"/>
                                            <Button Grid.Column="1"
                                                    Content="+ Thêm Chương mới"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="BtnAddChapter_Click"/>
                                        </Grid>

                                        <ListBox x:Name="lstChapters"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="14,10"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#1E293B"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Content="🗑 Xóa chương"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Background="#FEE2E2"
                                                                    Foreground="#B91C1C"
                                                                    BorderThickness="0"
                                                                    Padding="10,5"
                                                                    FontSize="11.5"
                                                                    FontWeight="SemiBold"
                                                                    Cursor="Hand"
                                                                    Tag="{Binding}"
                                                                    Click="BtnDeleteChapterItem_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ==================== TAB 4: ANALYTICS & STUDENT RESULTS ==================== -->
                <Grid x:Name="viewAllResults" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="0.75*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Student Attempts History -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Lịch sử thi của tất cả học sinh"
                                           FontSize="15.5"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📊 Xuất Excel/CSV"
                                            Background="#DCFCE7"
                                            Foreground="#15803D"
                                            BorderThickness="0"
                                            Padding="10,6"
                                            Margin="0,0,8,0"
                                            FontSize="11.5"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Click="BtnExportResultsCsv_Click"/>
                                    <Button Content="Xóa lịch sử"
                                            Background="#FEE2E2"
                                            Foreground="#B91C1C"
                                            BorderThickness="0"
                                            Padding="10,6"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="BtnClearAllHistory_Click"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="itemsAdminHistory">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="14,12"
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="115"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ExamTitle}" FontSize="14.5" FontWeight="Bold" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding StudentAndDateText}" FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ResultRatioText}" FontSize="14.5" FontWeight="Bold" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding DurationFormatted, StringFormat='⏱ Thời gian: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ScoreText}" FontSize="16.5" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                                        <Border CornerRadius="5" Padding="9,3" Margin="0,4,0,0" HorizontalAlignment="Right"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FEE2E2"/><Style.Triggers><DataTrigger Binding="{Binding IsPassed}" Value="True"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#B91C1C"/><Style.Triggers><DataTrigger Binding="{Binding IsPassed}" Value="True"><Setter Property="Foreground" Value="#15803D"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Right: Score Distribution & Top Most Missed Questions -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Score Distribution Column Chart -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Biểu đồ Phổ điểm học sinh" FontSize="15.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,14,14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Horizontal Baseline -->
                                        <Border Grid.Row="0" Grid.ColumnSpan="4" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                        <!-- Column 1: Excellent (>= 8.0) -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtDistExcellent" Text="0" FontSize="12" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <Border x:Name="barDistExcellent" Width="38" Height="6" Background="#16A34A" CornerRadius="6,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="Giỏi" FontSize="12" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                                            <TextBlock Text="≥ 8.0 điểm" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Column 2: Good (6.5 - 7.9) -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtDistGood" Text="0" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <Border x:Name="barDistGood" Width="38" Height="6" Background="#2563EB" CornerRadius="6,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="Khá" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="6.5 - 7.9" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Column 3: Pass (5.0 - 6.4) -->
                                        <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtDistPass" Text="0" FontSize="12" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <Border x:Name="barDistPass" Width="38" Height="6" Background="#D97706" CornerRadius="6,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="Trung bình" FontSize="12" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Center"/>
                                            <TextBlock Text="5.0 - 6.4" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Column 4: Fail (< 5.0) -->
                                        <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtDistFail" Text="0" FontSize="12" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <Border x:Name="barDistFail" Width="38" Height="6" Background="#DC2626" CornerRadius="6,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="Yếu" FontSize="12" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center"/>
                                            <TextBlock Text="&lt; 5.0 điểm" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Top câu hỏi học sinh sai nhiều nhất" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="itemsWrongStats">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding QuestionText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                    <TextBlock FontSize="11" Foreground="#B91C1C" FontWeight="Bold" Margin="0,4,0,0">
                                                        <Run Text="{Binding WrongRateText, Mode=OneWay}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding ExamTitle, Mode=OneWay}" Foreground="#64748B" FontWeight="Normal"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== TAB 5: MANAGE USER ACCOUNTS ==================== -->
                <Grid x:Name="viewManageUsers" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="colUserList" Width="1*"/>
                        <ColumnDefinition x:Name="colUserEditor" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Full-screen: User Accounts List -->
                    <Border x:Name="borderUserListContainer" Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Danh sách Tài khoản hệ thống" FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>

                                </StackPanel>
                                <Button Content="+ Thêm tài khoản mới"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="16,9"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="BtnResetUserForm_Click"/>
                            </Grid>

                            <!-- Search & Role Filter for Users -->
                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Tìm kiếm theo họ tên hoặc tên đăng nhập:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSearchUsers"
                                             Style="{StaticResource InputTextBox}"
                                             TextChanged="TxtSearchUsers_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Lọc theo phân quyền:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cboFilterUserRole"
                                              Height="36"
                                              SelectedIndex="0"
                                              FontSize="12.5"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="CboFilterUserRole_SelectionChanged">
                                        <ComboBoxItem Content="Tất cả vai trò" Tag="All"/>
                                        <ComboBoxItem Content="Giáo viên" Tag="Admin"/>
                                        <ComboBoxItem Content="Học sinh" Tag="User"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="🔍 Tìm kiếm"
                                        VerticalAlignment="Bottom"
                                        Height="36"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="16,0"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="BtnSearchUsers_Click"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     x:Name="lstUsers"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                                    <TextBlock FontSize="12.5" Foreground="#475569" Margin="0,4,0,0">
                                                        <Run Text="Tên đăng nhập: "/>
                                                        <Run Text="{Binding Username, Mode=OneWay}" FontWeight="Bold" Foreground="#2563EB"/>


                                                    </TextBlock>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Style="{StaticResource RoleBadgeBorderStyle}"
                                                        CornerRadius="6"
                                                        Padding="12,6"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RoleDisplay}"
                                                               Style="{StaticResource RoleBadgeTextStyle}"
                                                               FontSize="12"
                                                               FontWeight="Bold"/>
                                                </Border>

                                                <Button Grid.Column="2"
                                                        Content="✎ Sửa"
                                                        Background="#EFF6FF"
                                                        Foreground="#2563EB"
                                                        BorderThickness="0"
                                                        Padding="14,8"
                                                        FontSize="12.5"
                                                        FontWeight="Bold"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnEditUserItem_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Full-screen: User Account Editor Panel -->
                    <Border x:Name="borderUserEditorPanel" Grid.Column="1" Visibility="Collapsed" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <TextBlock x:Name="txtUserFormTitle"
                                               Text="Thêm tài khoản mới"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"
                                               VerticalAlignment="Center"/>
                                    <Button Content="← Quay lại danh sách tài khoản"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="#F1F5F9"
                                            Foreground="#475569"
                                            BorderThickness="0"
                                            Padding="14,7"
                                            FontSize="12.5"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Click="BtnCloseUserEditor_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Tên đăng nhập" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtUserUsername" Style="{StaticResource InputTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Họ và tên đầy đủ" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtUserFullName" Style="{StaticResource InputTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock x:Name="txtUserPasswordLabel" Text="Mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtUserPassword" Style="{StaticResource InputTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Phân quyền" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cboUserRole" Height="36" SelectedIndex="0" FontSize="13" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Học sinh" Tag="User"/>
                                            <ComboBoxItem Content="Giáo viên" Tag="Admin"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            x:Name="btnSaveUser"
                                            Content="💾  Lưu tài khoản mới"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="BtnSaveUser_Click"/>
                                    <Button Grid.Column="1"
                                            x:Name="btnDeleteUser"
                                            Content="🗑 Xóa tài khoản"
                                            Visibility="Collapsed"
                                            Background="#FEE2E2"
                                            Foreground="#B91C1C"
                                            BorderThickness="0"
                                            Padding="16,10"
                                            Margin="10,0,0,0"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="BtnDeleteUser_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
