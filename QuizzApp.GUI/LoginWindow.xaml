<Window x:Class="QuizzApp.GUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống - QUIZ MASTER"
        Height="560"
        Width="860"
        MinHeight="480"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3563E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#244BC0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1D3A99"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FormPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.2*"/>
            <ColumnDefinition Width="5.8*"/>
        </Grid.ColumnDefinitions>

            <!-- LEFT BANNER -->
            <Border Grid.Column="0" Background="#172554">
                <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="44" Height="44" Background="#3563E9" CornerRadius="12">
                            <TextBlock Text="Q" Foreground="White" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="QUIZ MASTER" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Hệ thống thi trắc nghiệm" Foreground="#93C5FD" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Slogan -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Nền tảng kiểm tra &amp; quản lý đề thi thông minh"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   LineHeight="30"/>
                        <TextBlock Text="• Làm bài trắc nghiệm có đếm ngược thời gian&#x0a;• Chấm điểm tự động và giải thích chi tiết&#x0a;• Dashboard quản trị đề thi &amp; câu hỏi trực quan"
                                   Foreground="#CBD5E1"
                                   FontSize="12.5"
                                   Margin="0,16,0,0"
                                   LineHeight="22"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Quick Demo Accounts Box -->
                    <Border Grid.Row="2"
                            Background="#1E3A8A"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="TÀI KHOẢN DEMO CÓ SẴN (Bấm để điền nhanh):"
                                       Foreground="#93C5FD"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="⚡ Quản trị (admin)"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="8,7"
                                        Margin="0,0,5,0"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="BtnFillAdmin_Click"/>
                                <Button Grid.Column="1"
                                        Content="🎓 Học viên (hocvien)"
                                        Background="#0D9488"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="8,7"
                                        Margin="5,0,0,0"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="BtnFillStudent_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT LOGIN / REGISTER FORM -->
            <Border Grid.Column="1" Background="White" Padding="48,36">
                <Grid VerticalAlignment="Center" MaxWidth="420">
                    <StackPanel>
                        <TextBlock x:Name="txtFormTitle"
                                   Text="Đăng nhập tài khoản"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>
                        <TextBlock x:Name="txtFormSubtitle"
                                   Text="Nhập thông tin tài khoản để truy cập hệ thống"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,6,0,22"/>

                        <!-- FullName field (only visible in Register mode) -->
                        <StackPanel x:Name="panelFullName" Visibility="Collapsed" Margin="0,0,0,14">
                            <TextBlock Text="Họ và tên" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtFullName" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>

                        <!-- Username -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Tên đăng nhập" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtUsername" Style="{StaticResource FormTextBox}" Text="admin"/>
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="txtPassword" Style="{StaticResource FormPasswordBox}" KeyDown="TxtPassword_KeyDown"/>
                        </StackPanel>

                        <CheckBox x:Name="chkRememberMe"
                                  Content="Ghi nhớ tài khoản đăng nhập"
                                  IsChecked="True"
                                  FontSize="12"
                                  Foreground="#475569"
                                  Margin="0,2,0,6"/>

                        <!-- Error Message -->
                        <TextBlock x:Name="txtError"
                                   Text=""
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8"/>

                        <!-- Submit Button -->
                        <Button x:Name="btnSubmit"
                                Content="Đăng nhập →"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,12,0,16"
                                Click="BtnSubmit_Click"/>

                        <!-- Switch Login / Register -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtSwitchPrompt"
                                       Text="Chưa có tài khoản học viên?"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="btnToggleMode"
                                    Content="Đăng ký ngay"
                                    Background="Transparent"
                                    Foreground="#2563EB"
                                    BorderThickness="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Margin="6,0,0,0"
                                    Cursor="Hand"
                                    Click="BtnToggleMode_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
    </Grid>
</Window>
